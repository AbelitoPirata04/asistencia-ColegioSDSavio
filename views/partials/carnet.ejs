<%
  // Carnet tamaño CR80 (85,6 × 54 mm). Los elementos con data-k se actualizan desde JavaScript.
  const k = locals.m || {};
  const sig = String(k.nombre_completo || '').split(' ').filter(Boolean).slice(0, 2).map(function (p) { return p[0]; }).join('').toUpperCase();
  const cargoTxt = [k.detalle, k.rol === 'docente' ? k.nivel : null].filter(Boolean).join(' · ');
%>
<div class="carnet-marco">
  <article class="carnet <%= k.rol === 'directivo' ? 'carnet--directivo' : '' %>" id="carnet">
    <!-- Ondas de fondo: roja arriba, roja abajo, ambas con borde amarillo -->
    <svg class="carnet__ondas" viewBox="0 0 856 540" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="carnetRojo" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#B80000"/><stop offset=".65" stop-color="#8A0000"/><stop offset="1" stop-color="#5E0000"/>
        </linearGradient>
      </defs>
      <path d="M0 0H856V112C700 150 560 96 420 122S140 160 0 132Z" fill="url(#carnetRojo)"/>
      <path d="M0 132C140 160 280 112 420 122S700 150 856 112V124C700 166 560 112 420 138S140 176 0 146Z" fill="#FFD21F"/>
      <path d="M0 412C160 382 300 432 450 416S720 380 856 396V540H0Z" fill="url(#carnetRojo)"/>
      <path d="M0 400C160 370 300 420 450 404S720 368 856 384V398C720 382 600 418 450 418S160 384 0 414Z" fill="#FFD21F"/>
    </svg>

    <div class="carnet__cabeza">
      <span class="carnet__escudo"><img src="/img/logo.jpg" alt=""></span>
      <span class="carnet__separador"></span>
      <div class="carnet__colegio">
        <strong>Colegio Santo Domingo Savio</strong>
        <span>Control de asistencia</span>
      </div>
    </div>

    <div class="carnet__centro">
      <img class="carnet__agua" src="/img/logo.jpg" alt="">
      <div class="carnet__foto">
        <img data-k="foto" src="<%= k.foto_perfil || '' %>" alt="" <%= k.foto_perfil ? '' : 'hidden' %>>
        <span data-k="sigla" <%= k.foto_perfil ? 'hidden' : '' %>><%= sig || '··' %></span>
        <% if (locals.editableFoto) { %>
          <button type="button" class="carnet__cambiar" id="btnFotoCarnet"><%= k.foto_perfil ? 'Cambiar foto' : 'Agregar foto' %></button>
        <% } %>
      </div>
      <div class="carnet__datos">
        <span class="carnet__rol" data-k="rol"><%= k.rol === 'directivo' ? 'Directivo' : 'Docente' %></span>
        <strong data-k="nombre"><%= k.nombre_completo || 'Nombre del miembro' %></strong>
        <i class="carnet__raya"></i>
        <span class="carnet__cargo" data-k="cargo"><%= cargoTxt %></span>
      </div>
    </div>

    <div class="carnet__pie">
      <span class="carnet__dato">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10.5"/><rect x="6" y="8" width="12" height="8.5" rx="1.5"/><circle cx="9.5" cy="11.5" r="1.4"/><path d="M8 14.6c.4-.9 1-1.3 1.5-1.3s1.1.4 1.5 1.3M13 11h3M13 13.5h3"/></svg>
        C.C. <b data-k="cedula"><%= k.cedula || '—' %></b>
      </span>
      <span class="carnet__separador carnet__separador--pie"></span>
      <span class="carnet__dato">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="5" cy="12" r="1.6" fill="currentColor" stroke="none"/><path d="M9 8.5a5 5 0 0 1 0 7M12.5 5.5a9.5 9.5 0 0 1 0 13M16 3a13 13 0 0 1 0 18"/></svg>
        <em>RFID</em> <b data-k="tarjeta"><%= k.codigo_tarjeta_rfid || 'sin asignar' %></b>
      </span>
    </div>
  </article>
</div>
