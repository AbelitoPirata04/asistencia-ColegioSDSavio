<%- include('partials/cabecera') %>

<!-- Portada del equipo -->
<section class="hw-portada">
  <div class="hw-portada__texto">
    <span class="portada__colegio">Así funciona por dentro</span>
    <h2>El equipo de asistencia</h2>
    <p>Un ESP32-S3 con cámara conectado a un sensor de huella, un lector de tarjetas, una pantalla, un reloj y un buzzer. Cuando alguien pasa, identifica a la persona, le toma una foto y lo envía al panel en segundos.</p>
    <div class="hw-estado">
      <div><span class="equipo-tarjeta__luz" id="hwLuz"></span><strong id="hwEstado">Consultando…</strong><small>Estado</small></div>
      <div><strong id="hwModo">—</strong><small>Modo</small></div>
      <div><strong id="hwSenal">—</strong><small>Última señal</small></div>
    </div>
    <div class="hw-reinicio">
      <button type="button" class="btn btn--claro" id="btnReiniciar">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6M20 4v5h-5"/></svg>
        Reiniciar equipo
      </button>
      <span id="hwReinicioTexto" role="status" aria-live="polite"></span>
    </div>
    <dl class="hw-cifras" id="hwCifras">
      <div><dt>Huellas registradas</dt><dd id="hwHuellas">—</dd></div>
      <div><dt>Tarjetas asignadas</dt><dd id="hwTarjetas">—</dd></div>
      <div><dt>Pases hoy</dt><dd id="hwPases">—</dd></div>
      <div><dt>Fotos tomadas</dt><dd id="hwFotos">—</dd></div>
    </dl>
  </div>
  <img class="hw-portada__mascota" src="/img/hardware/esp32-mascota.png" alt="El ESP32-S3 con cámara, la mascota del proyecto">
</section>

<!-- Cómo funciona un pase -->
<header class="seccion-titulo"><div><h2>Qué pasa cuando alguien marca</h2><p>Todo ocurre en unos dos segundos</p></div></header>
<ol class="flujo">
  <li><img src="/img/iconos/huella.png" alt=""><strong>Pone el dedo o pasa la tarjeta</strong><span>El R307 o el RC522 identifican a la persona</span></li>
  <li><img src="/img/hardware/esp32-s3-cam.jpg" alt="" class="flujo__foto"><strong>Se toma la foto</strong><span>La cámara captura el instante exacto</span></li>
  <li><img src="/img/iconos/base-datos.png" alt=""><strong>El servidor valida</strong><span>Revisa quién es y si es llegada o salida</span></li>
  <li><img src="/img/hardware/lcd-16x2.jpg" alt="" class="flujo__foto"><strong>Saluda y suena</strong><span>"Bienvenido(a)" en la pantalla y un pitido</span></li>
  <li><img src="/img/iconos/reloj-alerta.png" alt=""><strong>Aviso en el panel</strong><span>Notificación y voz para el administrador</span></li>
</ol>

<!-- Diagrama de conexiones -->
<header class="seccion-titulo">
  <div><h2>Cómo está conectado</h2><p>Pines reales del código del equipo · pase el mouse por un componente para ver sus cables</p></div>
</header>
<section class="tarjeta diagrama">
  <svg class="diagrama__svg" id="diagrama" viewBox="0 62 1000 480" role="img" aria-labelledby="diagramaTitulo">
    <title id="diagramaTitulo">Diagrama de conexiones del ESP32-S3 con sus módulos</title>

    <!-- ===== I2C: pantalla y reloj comparten SDA (GPIO 1) y SCL (GPIO 2) ===== -->
    <g class="cable cable--i2c" data-mod="lcd rtc">
      <polyline points="250,110 290,110 290,236 420,236"/>
      <polyline points="250,140 305,140 305,266 420,266"/>
      <polyline points="250,370 290,370 290,236"/>
      <polyline points="250,400 305,400 305,266"/>
      <text x="362" y="229">GPIO 1 · SDA</text>
      <text x="362" y="259">GPIO 2 · SCL</text>
    </g>
    <!-- ===== Serial (UART): huella ===== -->
    <g class="cable cable--uart" data-mod="huella">
      <polyline points="750,108 700,108 700,226 580,226"/>
      <polyline points="750,138 715,138 715,252 580,252"/>
      <text x="636" y="219">41 ← TX</text>
      <text x="636" y="245">42 → RX</text>
    </g>
    <!-- ===== SPI: RFID ===== -->
    <g class="cable cable--spi" data-mod="rfid">
      <polyline points="750,352 740,352 740,290 580,290"/>
      <polyline points="750,374 728,374 728,310 580,310"/>
      <polyline points="750,396 716,396 716,330 580,330"/>
      <polyline points="750,418 704,418 704,350 580,350"/>
      <polyline points="750,440 692,440 692,370 580,370"/>
      <text x="590" y="286">21 SS</text><text x="590" y="306">39 SCK</text><text x="590" y="326">38 MOSI</text>
      <text x="590" y="346">40 MISO</text><text x="590" y="366">14 RST</text>
    </g>
    <!-- ===== GPIO: buzzer ===== -->
    <g class="cable cable--gpio" data-mod="buzzer">
      <polyline points="500,420 500,468"/>
      <text x="510" y="450" text-anchor="start">GPIO 47</text>
    </g>

    <!-- ===== Módulos ===== -->
    <g class="modulo" data-mod="lcd">
      <rect x="30" y="70" width="220" height="100" rx="12"/>
      <rect class="modulo__pantalla" x="48" y="112" width="120" height="36" rx="4"/>
      <text class="modulo__nombre" x="48" y="96">Pantalla LCD 16x2</text>
      <text class="modulo__dato" x="180" y="128">I2C</text><text class="modulo__dato" x="180" y="144">0x27</text>
    </g>
    <g class="modulo" data-mod="rtc">
      <rect x="30" y="330" width="220" height="100" rx="12"/>
      <circle class="modulo__pila" cx="78" cy="395" r="22"/>
      <text class="modulo__nombre" x="48" y="356">Reloj RTC DS3231</text>
      <text class="modulo__dato" x="112" y="392">Pila propia</text><text class="modulo__dato" x="112" y="410">I2C · 0x68</text>
    </g>
    <g class="modulo" data-mod="huella">
      <rect x="750" y="70" width="220" height="100" rx="12"/>
      <rect class="modulo__vidrio" x="890" y="92" width="58" height="58" rx="8"/>
      <text class="modulo__nombre" x="768" y="96">Huella R307</text>
      <text class="modulo__dato" x="768" y="128">Serial</text><text class="modulo__dato" x="768" y="144">57 600 baudios</text>
    </g>
    <g class="modulo" data-mod="rfid">
      <rect x="750" y="320" width="220" height="140" rx="12"/>
      <path class="modulo__ondas" d="M905 392a14 14 0 0 1 0 22M915 382a28 28 0 0 1 0 42M925 372a42 42 0 0 1 0 62"/>
      <circle class="modulo__punto" cx="895" cy="403" r="5"/>
      <text class="modulo__nombre" x="768" y="346">Lector RFID RC522</text>
      <text class="modulo__dato" x="768" y="380">SPI</text><text class="modulo__dato" x="768" y="396">13,56 MHz</text>
    </g>
    <g class="modulo" data-mod="buzzer">
      <rect x="430" y="468" width="140" height="64" rx="12"/>
      <circle class="modulo__pila" cx="466" cy="500" r="16"/>
      <text class="modulo__nombre" x="492" y="496">Buzzer</text><text class="modulo__dato" x="492" y="514">pasivo</text>
    </g>

    <!-- ===== ESP32 en el centro ===== -->
    <g class="modulo modulo--esp32" data-mod="esp32">
      <rect class="esp32__placa" x="420" y="150" width="160" height="270" rx="16"/>
      <% for (let i = 0; i < 11; i++) { %>
        <rect class="esp32__pin" x="412" y="<%= 172 + i * 22 %>" width="12" height="8" rx="2"/>
        <rect class="esp32__pin" x="576" y="<%= 172 + i * 22 %>" width="12" height="8" rx="2"/>
      <% } %>
      <rect class="esp32__camara" x="466" y="112" width="68" height="56" rx="10"/>
      <circle class="esp32__lente" cx="500" cy="138" r="16"/><circle class="esp32__brillo" cx="500" cy="138" r="7"/>
      <text class="esp32__nombre" x="500" y="262">ESP32-S3</text>
      <text class="esp32__dato" x="500" y="284">WROOM-1</text>
      <text class="esp32__dato" x="500" y="302">N16R8</text>
      <text class="esp32__dato esp32__dato--chico" x="500" y="96">Cámara integrada</text>
      <text class="esp32__wifi" x="500" y="392">WiFi 2,4 GHz</text>
    </g>
  </svg>
  <ul class="diagrama__leyenda">
    <li><i class="ley--i2c"></i>I2C · pantalla y reloj comparten 2 cables</li>
    <li><i class="ley--uart"></i>Serial · sensor de huella</li>
    <li><i class="ley--spi"></i>SPI · lector de tarjetas</li>
    <li><i class="ley--gpio"></i>Pin digital · buzzer</li>
  </ul>
</section>

<!-- Componentes -->
<header class="seccion-titulo"><div><h2>Cómo se construyó</h2><p>Cada pieza del equipo y para qué sirve</p></div></header>
<div class="piezas" id="piezas">
  <% componentes.forEach(function (c) { %>
    <article class="pieza pieza--<%= c.bus %>" data-mod="<%= c.id %>" tabindex="0">
      <div class="pieza__foto"><img src="/img/hardware/<%= c.foto %>" alt="<%= c.nombre %>" loading="lazy"></div>
      <div class="pieza__cuerpo">
        <span class="pieza__apodo"><%= c.apodo %></span>
        <h3><%= c.nombre %></h3>
        <p><%= c.funcion %></p>
        <ul class="pieza__datos"><% c.datos.forEach(function (d) { %><li><%= d %></li><% }) %></ul>
        <table class="pieza__pines">
          <% c.pines.forEach(function (p) { %><tr><td><%= p[0] %></td><td><b>GPIO <%= p[1] %></b></td></tr><% }) %>
        </table>
      </div>
    </article>
  <% }) %>
</div>

<%- include('partials/pie', { script: 'hardware.js' }) %>
